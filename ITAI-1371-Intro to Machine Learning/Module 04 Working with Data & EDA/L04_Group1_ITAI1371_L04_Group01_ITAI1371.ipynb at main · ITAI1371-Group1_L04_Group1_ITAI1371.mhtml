">.</span><span class=3D"n">hist</span><span class=3D"p">,</span> <span cla=
ss=3D"s1">'Age'</span><span class=3D"p">,</span> <span class=3D"n">bins</sp=
an><span class=3D"o">=3D</span><span class=3D"mi">20</span><span class=3D"p=
">)</span>
